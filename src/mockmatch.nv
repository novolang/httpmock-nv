// mockmatch.nv — the decision, and it is a pure function.
//
// `decide` takes a list of expectations, the number of calls each has
// already served, and one request, and answers which expectation serves
// it.  When none does, the answer says which field of which expectation
// missed.  No function in this module performs an effect, so the
// matching is tested with no port, no process and no teardown.
//
// `HmUnmatched` carries one `HmMiss` per expectation: the index, the
// field that differed, what was wanted in matchers-nv's `describe` and
// what arrived in its `describe_mismatch`.  A report reads:
//
//     no expectation matched GET /users/7
//       #0 the token endpoint: header Authorization wanted a string
//          starting with "Bearer ", was "Basic dXNlcg=="
//
// The fields of an expectation are checked in a fixed order: method,
// path, query, headers, body.  The first miss of an expectation is the
// one reported.  The order is cheapest first and is the order a person
// reads a request in, and an expectation that differs in four fields is
// almost always wrong in the first.
//
// An expectation that has served as many requests as it allows is skipped
// when a later expectation matches, so a list can answer a sequence of
// calls to one path with a sequence of replies.  When every expectation
// that matches is exhausted, the answer is `HmExhausted` for the first.
//
// A path is matched by router-nv under the expectation's `RoutePolicy`.
// A path that router-nv would answer with a redirect, such as `/users/`
// for `/users` under `web_policy`, matches the expectation with the
// spelling the redirect names.

use mockexpect
use routepat
use routetree
use routematch
use matchers

// Which part of a request an expectation disagreed about.
//
// A type rather than a string, so a runner can group misses by field
// and a test of this module can assert the field rather than parse a
// sentence.
pub enum HmField
    HmMethodField
    HmPathField
    HmQueryField(name: Str)
    HmHeaderField(name: Str)
    HmBodyField

// Why one expectation did not match this request.
pub struct HmMiss
    // Which expectation, by index in the list handed to `decide`.
    expectation: Int
    // Its one-line description, carried so a report does not have to
    // hold the expectation list to render a miss.
    label: Str
    field: HmField
    // What the expectation wanted, in matchers-nv's words —
    // `matchers.describe` for a field with a matcher, and a plain
    // spelling for the method and the path.
    wanted: Str
    // What arrived, in matchers-nv's words —
    // `matchers.describe_mismatch`, which is why the two read as one
    // sentence.
    got: Str

// What a request does.
pub enum HmDecision
    // Expectation `index` serves it, with this response.  The bound
    // path parameters come with it, because a response that echoes
    // `:id` needs them and looking them up again would re-run the
    // match.
    HmServe(index: Int, params: [HmBinding])
    // Nothing matched, and here is why each expectation did not.
    HmUnmatched(misses: [HmMiss])
    // An expectation matched, and it has already been served as many
    // times as it allows.  Its own answer rather than a miss, because
    // "called twice" and "never matched" are different bugs and a mock
    // that reported the second for the first sends a reader looking at
    // their matchers.
    HmExhausted(index: Int, label: Str, limit: Int)

// A path parameter bound by the match.
pub struct HmBinding
    name: Str
    value: Str

// What a request looks like to this module.
//
// A value of this package's own rather than the standard library's
// `HttpRequest`, and the reason is the one that makes the module `[]`:
// a test of the matching writes one of these in three lines, where
// building an `HttpRequest` means naming nine fields, six of which the
// decision never reads. `mockserver` converts.
pub struct HmRequest
    method: Str
    // Path only — no query string, no fragment.
    path: Str
    // The query, parsed into pairs, in the order they appeared.
    query: [HmBinding]
    // Header names as they arrived; the comparison folds case.
    headers: [HmBinding]
    // The body as text.  A mock is for testing an HTTP client, and a
    // client's request bodies are text in every case a person writes a
    // matcher for; a binary body matches only a matcher that ignores it.
    body: Str

// A request, for a test of the matching.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.request("GET", "/users/7").path)
// ```
pub fn request(method: Str, path: Str) -> HmRequest []
    HmRequest { method: method, path: path, query: [], headers: [], body: "" }

// The request with a query parameter.
//
// ```novo
// use mockmatch
// use std.list
//
// fn main() [io]
//     let r = mockmatch.with_query(mockmatch.request("GET", "/s"), "q", "novo")
//     println("${list.len(r.query)}")
// ```
pub fn with_query(r: HmRequest, name: Str, value: Str) -> HmRequest []
    HmRequest { method: r.method, path: r.path,
                query: list.concat(r.query, [HmBinding { name: name, value: value }]),
                headers: r.headers, body: r.body }

// The request with a header.
//
// ```novo
// use mockmatch
// use std.list
//
// fn main() [io]
//     let r = mockmatch.with_header(mockmatch.request("GET", "/t"), "Accept", "text/plain")
//     println("${list.len(r.headers)}")
// ```
pub fn with_header(r: HmRequest, name: Str, value: Str) -> HmRequest []
    HmRequest { method: r.method, path: r.path, query: r.query,
                headers: list.concat(r.headers, [HmBinding { name: name, value: value }]),
                body: r.body }

// The request with a body.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.with_body(mockmatch.request("POST", "/u"), "ping").body)
// ```
pub fn with_body(r: HmRequest, body: Str) -> HmRequest []
    HmRequest { method: r.method, path: r.path, query: r.query, headers: r.headers,
                body: body }

// The request built from a target with a query string on it.
//
// `"/s?q=novo&page=2"` in, the path and the pairs out — the parsing a
// caller would otherwise write beside every test.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.request_target("GET", "/s?q=novo&page=2").path)
// ```
pub fn request_target(method: Str, target: Str) -> HmRequest []
    let bare = match str.index(target, "#")
        Some(i) => str.slice(target, 0, i)
        None    => target
    match str.index(bare, "?")
        None    => request(method, bare)
        Some(i) =>
            var pairs: [HmBinding] = []
            for p in url.query_params(str.slice(bare, i + 1, str.len(bare)))
                list.push(pairs, HmBinding { name: p.0, value: p.1 })
            HmRequest { method: method, path: str.slice(bare, 0, i), query: pairs,
                        headers: [], body: "" }

// THE DECISION.  Which expectation serves this request, or why none
// does.
//
// `calls[i]` is how many times expectation `i` has already been served;
// a caller with no history passes an empty list and every count is
// zero.  Taking the counts as an argument rather than reading them from
// the mock is what keeps this function `[]` — and what lets a test
// assert the times-called behaviour without a server.
//
// First match wins, in list order.
//
// ```novo
// use mockexpect
// use mockmatch
//
// fn main() [io]
//     let es = [mockexpect.expect(HmGet, "/users/:id")]
//     println(mockmatch.decision_name(mockmatch.decide(es, [], mockmatch.request("GET", "/users/7"))))
// ```
pub fn decide(es: [mockexpect.HmExpectation], calls: [Int], r: HmRequest) -> HmDecision []
    var exhausted: ?HmDecision = None
    var misses: [HmMiss] = []
    for i in 0..list.len(es)
        let e = es[i]
        match miss_of(e, i, r)
            Some(m) => list.push(misses, m)
            None    =>
                let served = if i < list.len(calls)
                    calls[i]
                else
                    0
                if mockexpect.times_exhausted(e.times, served)
                    if exhausted == None
                        exhausted = Some(HmExhausted(i, mockexpect.describe(e), e.times.at_most))
                else
                    return HmServe(i, bindings(e, r))
    match exhausted
        Some(d) => d
        None    => HmUnmatched(misses)

// Whether one expectation matches, ignoring how many times it has been
// served.
//
// The predicate under `decide`, published because a test of one rule
// should not have to build a list and read an index out of a decision.
//
// ```novo
// use mockexpect
// use mockmatch
//
// fn main() [io]
//     let e = mockexpect.expect(HmGet, "/users/:id")
//     let hit = mockmatch.matches(e, mockmatch.request("GET", "/users/7"))
//     println("${hit}")
// ```
pub fn matches(e: mockexpect.HmExpectation, r: HmRequest) -> Bool []
    match miss_of(e, 0, HmRequest { method: r.method, path: r.path, query: r.query,
                                    headers: r.headers, body: r.body })
        Some(_) => false
        None    => true

// Why one expectation did not match, or `None` when it did.
//
// The first miss in the fixed field order — method, path, query,
// headers, body.
//
// ```novo
// use mockexpect
// use mockmatch
//
// fn main() [io]
//     let e = mockexpect.expect(HmGet, "/users/:id")
//     match mockmatch.miss_of(e, 0, mockmatch.request("POST", "/users/7"))
//         Some(m) => println(mockmatch.field_name(m.field))
//         None    => println("matched")
// ```
pub fn miss_of(e: mockexpect.HmExpectation, index: Int, r: HmRequest) -> ?HmMiss []
    let label = mockexpect.describe(e)
    if e.method != HmAnyMethod and mockexpect.method_name(e.method) != r.method
        return Some(HmMiss { expectation: index, label: label, field: HmMethodField,
                             wanted: mockexpect.method_name(e.method), got: r.method })
    if not path_matches(e, r.path)
        return Some(HmMiss { expectation: index, label: label, field: HmPathField,
                             wanted: e.path.source, got: r.path })
    for rule in e.query
        match binding(r.query, rule.name)
            Some(v) =>
                if not matchers.matches(rule.value, v)
                    return Some(HmMiss { expectation: index, label: label,
                                         field: HmQueryField(rule.name),
                                         wanted: describe_wanted(rule.value),
                                         got: describe_got(rule.value, v) })
            None    =>
                if rule.required
                    return Some(HmMiss { expectation: index, label: label,
                                         field: HmQueryField(rule.name),
                                         wanted: describe_wanted(rule.value), got: "absent" })
    for rule in e.headers
        match header(r, rule.name)
            Some(v) =>
                if not matchers.matches(rule.value, v)
                    return Some(HmMiss { expectation: index, label: label,
                                         field: HmHeaderField(rule.name),
                                         wanted: describe_wanted(rule.value),
                                         got: describe_got(rule.value, v) })
            None    =>
                if rule.required
                    return Some(HmMiss { expectation: index, label: label,
                                         field: HmHeaderField(rule.name),
                                         wanted: describe_wanted(rule.value), got: "absent" })
    match e.body
        None    => None
        Some(m) =>
            if matchers.matches(m, r.body)
                return None
            Some(HmMiss { expectation: index, label: label, field: HmBodyField,
                          wanted: describe_wanted(m),
                          got: describe_got(m, r.body) })

// The path parameters an expectation binds from a request.
//
// Empty when the expectation does not match.
//
// ```novo
// use mockexpect
// use mockmatch
// use std.list
//
// fn main() [io]
//     let e = mockexpect.expect(HmGet, "/users/:id")
//     let bs = mockmatch.bindings(e, mockmatch.request("GET", "/users/7"))
//     println("${list.len(bs)}")
// ```
pub fn bindings(e: mockexpect.HmExpectation, r: HmRequest) -> [HmBinding] []
    match path_match(e, r.path)
        Some(bs) => bs
        None     => []

// A binding's value by name, or `None`.
//
// The lookup a response builder and a header comparison both need; the
// header comparison folds case and this does not, which is why it takes
// the list rather than being a method on the request.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     match mockmatch.binding([], "id")
//         Some(v) => println(v)
//         None    => println("unbound")
// ```
pub fn binding(bs: [HmBinding], name: Str) -> ?Str []
    for b in bs
        if b.name == name
            return Some(b.value)
    None

// A header's value by name, compared case-insensitively.
//
// RFC 7230 § 3.2, and the single commonest reason a hand-rolled mock
// does not match: a client that sends `authorization` against an
// expectation that wrote `Authorization`.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     let r = mockmatch.with_header(mockmatch.request("GET", "/t"), "Accept", "text/plain")
//     match mockmatch.header(r, "accept")
//         Some(v) => println(v)
//         None    => println("absent")
// ```
pub fn header(r: HmRequest, name: Str) -> ?Str []
    let want = str.lower(name)
    for h in r.headers
        if str.lower(h.name) == want
            return Some(h.value)
    None

// The decision's short name: `serve`, `unmatched`, `exhausted`.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.decision_name(HmUnmatched([])))
// ```
pub fn decision_name(d: HmDecision) -> Str []
    match d
        HmServe(_, _)        => "serve"
        HmUnmatched(_)       => "unmatched"
        HmExhausted(_, _, _) => "exhausted"

// The field's name as a report writes it: `method`, `path`,
// `query q`, `header Authorization`, `body`.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.field_name(HmHeaderField("Authorization")))
// ```
pub fn field_name(f: HmField) -> Str []
    match f
        HmMethodField    => "method"
        HmPathField      => "path"
        HmQueryField(n)  => "query " + n
        HmHeaderField(n) => "header " + n
        HmBodyField      => "body"

// One miss as one line: the index, the label, the field, wanted, was.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     let m = HmMiss { expectation: 0, label: "the token endpoint",
//                      field: HmMethodField, wanted: "GET", got: "POST" }
//     println(mockmatch.miss_line(m))
// ```
pub fn miss_line(m: HmMiss) -> Str []
    flat("#${m.expectation} ${m.label}: ${field_name(m.field)} wanted ${m.wanted}, was ${m.got}")

// The whole unmatched report: the request line, then one line per
// expectation.
//
// What `mockserver` puts in the 404 body and what `mockverify` puts in
// a failure, so the two cannot drift.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.unmatched_report(mockmatch.request("POST", "/users"), []))
// ```
pub fn unmatched_report(r: HmRequest, misses: [HmMiss]) -> Str []
    var lines = ["no expectation matched " + request_line(r)]
    for m in misses
        list.push(lines, "  " + miss_line(m))
    str.join(lines, "\n")

// The request as one line: method, path, and the query if there is one.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.request_line(mockmatch.request("GET", "/users/7")))
// ```
pub fn request_line(r: HmRequest) -> Str []
    if list.len(r.query) == 0
        return r.method + " " + r.path
    var pairs: [(Str, Str)] = []
    for q in r.query
        list.push(pairs, (q.name, q.value))
    r.method + " " + r.path + "?" + url.query_string(pairs)

// A matcher's own description, which is where `wanted` comes from.
//
// A thin call into matchers-nv, published so that a caller building a
// report of their own writes the same words the mock does.
//
// ```novo
// use matchtext
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.describe_wanted(matchtext.starts_with("Bearer ")))
// ```
pub fn describe_wanted(m: Matcher<Str>) -> Str []
    matchers.describe(m)

// What a matcher says about a value that did not satisfy it, which is
// where `got` comes from.
//
// ```novo
// use matchtext
// use mockmatch
//
// fn main() [io]
//     println(mockmatch.describe_got(matchtext.starts_with("Bearer "), "Basic dXNlcg=="))
// ```
pub fn describe_got(m: Matcher<Str>, value: Str) -> Str []
    matchers.describe_mismatch(m, value)

// Whether two JSON documents are equal as JSON.
//
// Member order and insignificant whitespace do not distinguish them,
// which is what `mockexpect.with_body_json` compares with. Text that is
// not JSON on either side compares as text, so the function is total.
//
// ```novo
// use mockmatch
//
// fn main() [io]
//     let same = mockmatch.json_equal("{\"a\":1,\"b\":2}", "{\"b\":2,\"a\":1}")
//     println("${same}")
// ```
pub fn json_equal(a: Str, b: Str) -> Bool []
    let ja = json.parse(a)
    let jb = json.parse(b)
    match ja
        Some(x) =>
            match jb
                Some(y) => json.equals(x, y)
                None    => a == b
        None    => a == b

// The path parameters the expectation binds from `path`, or `None` when
// the path does not match.
fn path_match(e: HmExpectation, path: Str) -> ?[HmBinding]
    if not mockexpect.matchable(e)
        return None
    match routetree.insert_parsed(routetree.tree(e.policy), e.path, routepat.methods_any(), 0)
        // cov: skip — a tree that holds one route has nothing for the route to conflict with
        Err(_) => None
        Ok(t)  =>
            match routematch.match_path(t, path, "GET")
                RouteFound(m)        => Some(bound(path, m))
                RouteRedirect(to, _) => redirected(t, to)
                _                    => None

// The match of the spelling a redirect names.  Router-nv answers a
// redirect only for a spelling that matches.
fn redirected(t: routetree.RouteTree, path: Str) -> ?[HmBinding]
    match routematch.match_path(t, path, "GET")
        RouteFound(m) => Some(bound(path, m))
        // cov: skip — the redirect names a spelling that router-nv has just matched
        _             => None

fn bound(path: Str, m: RouteMatch) -> [HmBinding]
    var out: [HmBinding] = []
    for b in m.params
        list.push(out, HmBinding { name: b.name, value: routematch.param_str(path, m, b.name) ?? "" })
    out

fn path_matches(e: HmExpectation, path: Str) -> Bool
    match path_match(e, path)
        Some(_) => true
        None    => false

// A description on one line: line breaks become spaces.
fn flat(s: Str) -> Str
    str.replace(str.replace(s, "\r", " "), "\n", " ")
