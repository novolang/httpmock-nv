// mockserver.nv — the socket, and the four things about it that are hard.
//
// The port is zero and the kernel answers.  `start` binds port 0, which
// asks the operating system for an unused port, and `HmMock.port` is the
// one it gave.  A hard-coded port is flaky under a parallel run and
// under `TIME_WAIT`, and scanning for a free one is racy because the
// scan and the bind are two steps.  A test never writes a port; it gives
// its client `base_url`.
//
// The mock listens on the loopback address only.  A stub server has no
// reason to be reachable from the network.
//
// The teardown is explicit, because the language has no destructors.
// `stop` drains, closes the listener and answers.  `with_mock` starts a
// mock, runs a function with it and stops it when the function returns.
// A panic ends the process, so the listener goes with it.
//
// One mock runs per process.  The standard library's async server keeps
// its connection queue, its shutdown flag, its live-worker count and its
// handler in module-level state, so a second `serve_async` would
// overwrite the first one's and the first one's tasks would serve the
// second one's rules.  `start` therefore refuses a second mock with
// `HmAlreadyRunning`.
//
// The handler is one static function.  The standard library's app is a
// plain `fn` with a six-label row and no capture, so the rules live in
// `mockstate` and `dispatch` reads them.  `dispatch` and the two
// conversions are the only places in this package that name `HttpRequest`
// and `HttpResponse`.  Between reading the request and writing the
// response, `dispatch` calls `mockmatch.decide`, which has no effect.

use mockexpect
use mockmatch
use mockreply
use mockstate

// The running server's handle, and the port it was given.
var live: ?HttpServer = None
var held_port: Int    = 0

// An expectation paired with what it answers.
//
// Two types rather than one field on `HmExpectation`: the matching half
// is `[]` and testable on its own, and `mockmatch.decide` never needs to
// know what a rule replies.  `HmServe` carries an index, and the caller
// — here — looks the reply up.
pub struct HmRule
    expectation: mockexpect.HmExpectation
    reply: mockreply.HmReply

// A running mock.
//
// A small value a test carries around.  The rules are not in it: they
// were handed to `start` and live with the running server, so a
// `HmMock` copied into a helper function cannot get out of step with
// what is actually being served.
pub struct HmMock
    // The port the kernel gave.
    port: Int
    // `http://127.0.0.1:<port>`, with no trailing slash.
    base: Str
    // How many rules it was started with, so an index in a verdict is
    // readable without the list.
    rules: Int

// What can go wrong with the server half.
pub enum HmError
    // A mock is already running in this process, on that port.  See the
    // module comment: the standard library allows one.
    HmAlreadyRunning(port: Int)
    // The bind failed, with what the platform said.
    HmBindFailed(reason: Str)
    // `stop`, `recorded` or `verify` was called with no mock running.
    HmNotRunning
    // A rule's path pattern does not parse.  Refused at `start`, with
    // the pattern named, rather than becoming a rule that silently
    // matches nothing.
    HmBadPattern(index: Int, pattern: Str)
    // The listener could not be closed, with what the platform said.
    HmStopFailed(reason: Str)

// The sentence a `Result<_, HmError>` carries.
//
// SPEC § 3.4 admits a type as a `Result`'s error type only when it
// implements `Error`, so this impl is what lets `start` and `stop`
// answer their own refusal.
//
// `HmAlreadyRunning`'s message names the other port and says why one is
// the limit, because a person meeting it in a suite of forty tests
// needs to know it is the standard library and not their teardown.
//
// ```novo
// use mockserver
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Ok(_)  => println("running")
//         Err(e) => println(e.message())
// ```
impl Error for HmError
    fn message(self) -> Str
        match self
            HmAlreadyRunning(port) => "a mock is already running on port ${port}; the standard library runs one server per process"
            HmBindFailed(reason)   => "the mock could not bind: ${reason}"
            HmNotRunning           => "no mock is running"
            HmBadPattern(i, p)     => "the path pattern of rule ${i} does not parse: ${p}"
            HmStopFailed(reason)   => "the mock could not be stopped: ${reason}"

// An expectation paired with its reply.
//
// ```novo
// use mockexpect
// use mockreply
// use mockserver
//
// fn main() [io]
//     let r = mockserver.rule(mockexpect.expect(HmGet, "/ping"), mockreply.text(200, "pong"))
//     println(r.reply.body)
// ```
pub fn rule(e: mockexpect.HmExpectation, reply: mockreply.HmReply) -> HmRule []
    HmRule { expectation: e, reply: reply }

// Start a mock on a port the kernel chooses, bound to the loopback
// address only.
//
// Loopback and not every interface: a test's stub server has no reason
// to be reachable from the network, and a mock that bound `0.0.0.0`
// would be a listening service on every developer machine and every
// build agent that ran the suite.
//
// The row is what `http.server.serve_async` costs — `[io, fs, net,
// time, mutate, async]` — and not the `[net]` a reader might expect;
// the manifest says why.
//
// ```novo
// use mockexpect
// use mockreply
// use mockserver
//
// fn main() [io, fs, net, time, mutate, async]
//     let rs = [mockserver.rule(mockexpect.expect(HmGet, "/ping"), mockreply.text(200, "pong"))]
//     match mockserver.start(rs)
//         Ok(m)  => println(mockserver.base_url(m))
//         Err(e) => println(e.message())
// ```
pub fn start(rules: [HmRule]) -> Result<HmMock, HmError> [io, fs, net, time, mutate, async]
    start_on("127.0.0.1", 0, rules)

// Start a mock on an address and port the caller names.
//
// For the case a hard-coded port genuinely is the point — a client
// under test that reads the port from a configuration file somebody
// else wrote.  Port `0` still means "ask the kernel".
//
// ```novo
// use mockserver
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start_on("127.0.0.1", 0, [])
//         Ok(m)  => println("${m.port}")
//         Err(e) => println(e.message())
// ```
pub fn start_on(host: Str, port: Int,
                rules: [HmRule]) -> Result<HmMock, HmError> [io, fs, net, time, mutate, async]
    if live != None
        return Err(HmAlreadyRunning(held_port))
    for i in 0..list.len(rules)
        if not mockexpect.matchable(rules[i].expectation)
            return Err(HmBadPattern(i, rules[i].expectation.path.source))
    var es: [HmExpectation] = []
    var rs: [mockreply.HmReply] = []
    for r in rules
        list.push(es, r.expectation)
        list.push(rs, r.reply)
    mockstate.begin(es, rs)
    match http.server.serve_async_on(host, port, dispatch, http.server.serve_opts(), workers())
        Err(e)  => Err(HmBindFailed(e.message()))
        Ok(srv) =>
            live = Some(srv)
            held_port = srv.port()
            let shown = if host == ""
                "127.0.0.1"
            else
                host
            Ok(HmMock { port: held_port, base: "http://${shown}:${held_port}", rules: list.len(rules) })

// The base a client prepends: `http://127.0.0.1:<port>`, no trailing
// slash.
//
// ```novo
// use mockserver
//
// fn main() [io]
//     println(mockserver.base_url(HmMock { port: 8080, base: "http://127.0.0.1:8080", rules: 0 }))
// ```
pub fn base_url(m: HmMock) -> Str []
    m.base

// The full URL of a path on the mock.
//
// Takes the leading slash or leaves it off, so a caller pasting a path
// out of a specification does not have to think about it.
//
// ```novo
// use mockserver
//
// fn main() [io]
//     let m = HmMock { port: 8080, base: "http://127.0.0.1:8080", rules: 0 }
//     println(mockserver.url_for(m, "/users/7"))
// ```
pub fn url_for(m: HmMock, path: Str) -> Str []
    if str.starts_with(path, "/")
        return m.base + path
    m.base + "/" + path

// Stop the mock: stop accepting, drain what was accepted, close the
// listener.
//
// Total in the way a teardown has to be: `HmNotRunning` when there is
// nothing to stop, which is the answer a second `stop` gets and is not
// a reason to fail a test.
//
// ```novo
// use mockserver
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  =>
//             match mockserver.stop(m)
//                 Some(e) => println(e.message())
//                 None    => println("stopped")
// ```
pub fn stop(m: HmMock) -> ?HmError [io, net, time, mutate, async]
    stop_within(m, default_grace_ms())

// Stop the mock, waiting at most `grace_ms` for what is in flight.
//
// ```novo
// use mockserver
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  =>
//             match mockserver.stop_within(m, 100)
//                 Some(e) => println(e.message())
//                 None    => println("stopped")
// ```
pub fn stop_within(m: HmMock, grace_ms: Int) -> ?HmError [io, net, time, mutate, async]
    match live
        None    => Some(HmNotRunning)
        Some(s) =>
            live = None
            held_port = 0
            match http.server.shutdown_async(s, grace_ms)
                None    => None
                // cov: skip — closing a listener that was bound a moment ago does not fail, and a test cannot make it
                Some(e) => Some(HmStopFailed(e.message()))

// Start a mock, run `body` with it, stop it, answer what `body`
// answered.
//
// The shape that cannot be forgotten, and the one a single test should
// use.  The server is stopped when `body` returns; a panic in `body` ends
// the process, and the listener goes with it.
//
// `body` is a NAMED function, and its row is concrete for the same
// reason tempdir-nv's is: a function-typed parameter cannot bind an
// effect parameter, so the row here is the one a test body that talks
// to the mock actually needs: `[io, net, async]`.  `[async]` is not a
// choice — `http.client.get` declares `[net, async]`, because the
// client parks the calling task while the request is in flight — so a
// body row without it could not call the mock it was given.
//
// ```novo
// use mockserver
// use std.http
//
// fn fetch(m: HmMock) -> Bool [io, net, async]
//     match http.client.get(mockserver.url_for(m, "/ping"))
//         Some(b) => b == "pong"
//         None    => false
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.with_mock([], fetch)
//         Ok(ok) => println("${ok}")
//         Err(e) => println(e.message())
// ```
pub fn with_mock<T>(rules: [HmRule],
                    body: fn(HmMock) -> T [io, net, async]) -> Result<T, HmError> [io, fs, net, time, mutate, async]
    match start(rules)
        Err(e) => Err(e)
        Ok(m)  =>
            let value = body(m)
            let _ = stop(m)
            Ok(value)

// Whether a mock is running in this process.
//
// Published because "one mock per process" is a constraint a suite has
// to work with, and a helper that starts one needs to be able to ask.
//
// ```novo
// use mockserver
//
// fn main() [io, mutate]
//     println("${mockserver.is_running()}")
// ```
pub fn is_running() -> Bool [mutate]
    live != None

// The handler `start` hands to `http.server.serve_async`.
//
// Published, and with the standard library's own row, for two reasons:
// it is the row a reader needs in order to believe `start`'s, and a
// caller who wants the mock's behaviour INSIDE their own server mounts
// this rather than reimplementing the dispatch.
//
// Everything it does between reading the request and writing the
// response is `mockmatch.decide`, which is `[]`.
//
// ```novo
// use mockserver
// use std.http
//
// fn main() [io, fs, net, time, mutate, async]
//     let resp = mockserver.dispatch(http.server.request("GET", "/ping"))
//     println("${http.server.status(resp)}")
// ```
pub fn dispatch(req: HttpRequest) -> HttpResponse [io, fs, net, mutate, time, async]
    let r = to_request(req)
    match mockmatch.decide(mockstate.expectations(), mockstate.counts(), r)
        HmServe(i, params)           =>
            let reply = mockreply.render(mockstate.replies()[i], params)
            mockstate.note(r, i, reply.status, [])
            pause(reply.delay_ms)
            to_response(reply)
        HmUnmatched(misses)          =>
            let reply = mockreply.unmatched(r, misses)
            mockstate.note(r, 0 - 1, reply.status, misses)
            to_response(reply)
        HmExhausted(_, label, limit) =>
            let reply = mockreply.exhausted(label, limit)
            mockstate.note(r, 0 - 1, reply.status, [])
            to_response(reply)

// The standard library's request, as the value the matching works on.
//
// `[]`, and one of the two conversions that keep the rest of the
// package free of `HttpRequest`.  The query string is parsed into
// pairs and the body is read as text.
//
// ```novo
// use mockserver
// use mockmatch
// use std.http
//
// fn main() [io]
//     println(mockmatch.request_line(mockserver.to_request(http.server.request("GET", "/ping"))))
// ```
pub fn to_request(req: HttpRequest) -> mockmatch.HmRequest []
    var pairs: [HmBinding] = []
    for p in url.query_params(req.query)
        list.push(pairs, HmBinding { name: p.0, value: p.1 })
    var headers: [HmBinding] = []
    for h in req.headers
        list.push(headers, HmBinding { name: h.name, value: h.value })
    HmRequest { method: req.method, path: req.path, query: pairs, headers: headers,
                body: http.server.body_str(req) }

// A reply, as the standard library's response.
//
// The other conversion.  `[]`: building a response allocates and
// performs nothing — the delay is `dispatch`'s to honour, which is why
// it is not applied here.
//
// ```novo
// use mockreply
// use mockserver
// use std.http
//
// fn main() [io]
//     println("${http.server.status(mockserver.to_response(mockreply.text(200, "pong")))}")
// ```
pub fn to_response(r: mockreply.HmReply) -> HttpResponse []
    var resp = base_response(r)
    for h in r.headers
        if str.lower(h.name) != "content-type"
            resp = http.server.with_header(resp, h.name, h.value)
    resp

// How many worker tasks a mock runs: 4.
//
// Enough that a test of a client's own concurrency sees more than one
// request in flight, and small enough that a suite starting a mock per
// test is not spawning a pool each time.
//
// ```novo
// use mockserver
//
// fn main() [io]
//     println("${mockserver.workers()}")
// ```
pub fn workers() -> Int []
    4

// How long `stop` waits for what is in flight, by default: 500 ms.
//
// ```novo
// use mockserver
//
// fn main() [io]
//     println("${mockserver.default_grace_ms()}")
// ```
pub fn default_grace_ms() -> Int []
    500

// The standard library's response for a reply's status, content type and
// body.  The content type is the reply's `Content-Type` header, which
// `http.server.bytes` writes itself.
fn base_response(r: mockreply.HmReply) -> HttpResponse
    let kind = mockreply.header(r, "Content-Type") ?? ""
    if kind == "" and r.body == ""
        return http.server.empty(r.status)
    if kind == ""
        return http.server.bytes(r.status, "application/octet-stream", bytes.from_str(r.body))
    http.server.bytes(r.status, kind, bytes.from_str(r.body))

// Wait `ms` milliseconds, parking the task and not the thread.
fn pause(ms: Int) [time]
    if ms > 0
        time.sleep(int.to_float(ms) / 1000.0)
