// mockverify.nv — what the mock saw, and whether that is what was asked
// for.
//
// The mock records every request, matched or not.  An unmatched request
// is a recorded fact with the misses attached, so "the client called
// `/users/7` and I expected `/users/:id` with an `Authorization` header"
// is answerable afterwards from the values, without turning on a log.
//
// A request nobody expected is as interesting as an expectation nobody
// called, and most mock libraries report only the second.  Here it is
// `HmVerdict.unexpected`.  A request that matched an expectation already
// out of calls was answered `409`, and it is `HmVerdict.over_served`.
//
// The verdict is a value.  `verify_counts`, which holds the whole rule,
// has no effect.  Reading the recording costs `[mutate]`, because it
// reads the running server's shared state, and nothing more.  The
// recording stays readable after `mockserver.stop`.
//
// The failure text is matchers-nv's shape: what was expected, then what
// happened, one line each, with the expectation's label in front so a
// reader does not count indexes.

use mockexpect
use mockmatch
use mockserver
use mockstate
use std.test

// One request the mock saw.
pub struct HmRecorded
    // Where it came in the run, from 0, so an ordering assertion does
    // not need timestamps.
    sequence: Int
    request: mockmatch.HmRequest
    // The rule that served it, by index, or `0 - 1` when none did.
    served_by: Int
    // The status that went back.
    status: Int
    // Why each rule did not match, when none did.  Empty for a served
    // request — the misses of the rules that were merely later in the
    // list are not interesting, because first match wins.
    misses: [mockmatch.HmMiss]

// A rule that was not called as often as it said.
pub struct HmUnsatisfied
    rule: Int
    label: Str
    wanted: mockexpect.HmTimes
    calls: Int

// Whether the mock did what was asked of it.
pub struct HmVerdict
    satisfied: Bool
    // Rules whose call constraint was not met.
    unsatisfied: [HmUnsatisfied]
    // Requests no rule matched.
    unexpected: [HmRecorded]
    // Requests that matched a rule already out of calls.
    over_served: [HmRecorded]

// Every request the mock has seen, oldest first.
//
// `[mutate]` and nothing more: this reads the running server's shared
// state.
//
// ```novo
// use mockserver
// use mockverify
// use std.list
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => println("${list.len(mockverify.recorded(m))}")
// ```
pub fn recorded(m: mockserver.HmMock) -> [HmRecorded] [mutate]
    var out: [HmRecorded] = []
    for i in 0..mockstate.log_size()
        list.push(out, HmRecorded { sequence: i, request: mockstate.log_request(i),
                                    served_by: mockstate.log_served(i),
                                    status: mockstate.log_status(i),
                                    misses: mockstate.log_misses(i) })
    out

// How many requests the mock has seen.
//
// ```novo
// use mockserver
// use mockverify
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => println("${mockverify.request_count(m)}")
// ```
pub fn request_count(m: mockserver.HmMock) -> Int [mutate]
    mockstate.log_size()

// The most recent request, or `None`.
//
// The assertion a test of one call makes: start, call, look at what
// arrived.
//
// ```novo
// use mockserver
// use mockverify
// use mockmatch
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  =>
//             match mockverify.last_request(m)
//                 Some(rec) => println(mockmatch.request_line(rec.request))
//                 None      => println("nothing yet")
// ```
pub fn last_request(m: mockserver.HmMock) -> ?HmRecorded [mutate]
    let all = recorded(m)
    if list.len(all) == 0
        return None
    Some(all[list.len(all) - 1])

// Every request one rule served, oldest first.
//
// ```novo
// use mockserver
// use mockverify
// use std.list
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => println("${list.len(mockverify.served_by(m, 0))}")
// ```
pub fn served_by(m: mockserver.HmMock, rule: Int) -> [HmRecorded] [mutate]
    var out: [HmRecorded] = []
    for r in recorded(m)
        if r.served_by == rule
            list.push(out, r)
    out

// How many times each rule has been served, by index.
//
// The list `mockmatch.decide` takes as its `calls` argument, so a test
// can take the counts from a running mock and replay a decision
// against them with no server.
//
// ```novo
// use mockserver
// use mockverify
// use std.list
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => println("${list.len(mockverify.call_counts(m))}")
// ```
pub fn call_counts(m: mockserver.HmMock) -> [Int] [mutate]
    mockstate.counts()

// Every request no rule matched.
//
// ```novo
// use mockserver
// use mockverify
// use std.list
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => println("${list.len(mockverify.unexpected(m))}")
// ```
pub fn unexpected(m: mockserver.HmMock) -> [HmRecorded] [mutate]
    var out: [HmRecorded] = []
    for r in recorded(m)
        if is_unexpected(r)
            list.push(out, r)
    out

// Forget everything recorded so far, keeping the rules.
//
// For a suite that shares one mock across tests — the constraint the
// standard library's one-server-per-process rule makes common — so each
// test starts from an empty recording without a bind.
//
// ```novo
// use mockserver
// use mockverify
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  =>
//             match mockverify.clear(m)
//                 Some(e) => println(e.message())
//                 None    => println("cleared")
// ```
pub fn clear(m: mockserver.HmMock) -> ?mockserver.HmError [mutate]
    if not mockserver.is_running()
        return Some(HmNotRunning)
    mockstate.forget()
    None

// Whether the mock did what was asked of it.
//
// ```novo
// use mockserver
// use mockverify
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => println("${mockverify.verify(m, []).satisfied}")
// ```
pub fn verify(m: mockserver.HmMock, rules: [mockserver.HmRule]) -> HmVerdict [mutate]
    verify_counts(rules, call_counts(m), recorded(m))

// THE RULE, as a pure function.
//
// The rules, how many times each was served, and what was recorded, in
// — a verdict out.  `verify` is this over a running mock's state, and
// every interesting case in this package's suite is this call.
//
// ```novo
// use mockverify
//
// fn main() [io]
//     println("${mockverify.verify_counts([], [], []).satisfied}")
// ```
pub fn verify_counts(rules: [mockserver.HmRule], calls: [Int], seen: [HmRecorded]) -> HmVerdict []
    var unsatisfied: [HmUnsatisfied] = []
    for i in 0..list.len(rules)
        let e = rules[i].expectation
        let n = if i < list.len(calls)
            calls[i]
        else
            0
        if not mockexpect.times_satisfied(e.times, n)
            list.push(unsatisfied, HmUnsatisfied { rule: i, label: mockexpect.describe(e),
                                                   wanted: e.times, calls: n })
    var unexpected_calls: [HmRecorded] = []
    var over: [HmRecorded] = []
    for r in seen
        if is_unexpected(r)
            list.push(unexpected_calls, r)
        if r.status == 409
            list.push(over, r)
    HmVerdict { satisfied: list.len(unsatisfied) + list.len(unexpected_calls) + list.len(over) == 0,
                unsatisfied: unsatisfied, unexpected: unexpected_calls, over_served: over }

// Whether a verdict is a pass.
//
// ```novo
// use mockverify
//
// fn main() [io]
//     let v = HmVerdict { satisfied: true, unsatisfied: [], unexpected: [], over_served: [] }
//     println("${mockverify.satisfied(v)}")
// ```
pub fn satisfied(v: HmVerdict) -> Bool []
    v.satisfied

// The verdict as the text a person reads: what was expected, then what
// happened.
//
// matchers-nv's shape, one line per fact, with the rule's label in
// front so nobody counts indexes.
//
// ```novo
// use mockverify
//
// fn main() [io]
//     let v = HmVerdict { satisfied: true, unsatisfied: [], unexpected: [], over_served: [] }
//     println(mockverify.report(v))
// ```
pub fn report(v: HmVerdict) -> Str []
    if v.satisfied
        return "every expectation was met and nothing unexpected arrived"
    var lines: [Str] = []
    for u in v.unsatisfied
        list.push(lines, unsatisfied_line(u))
    for r in v.unexpected
        list.push(lines, "unexpected request: " + recorded_line(r))
    for r in v.over_served
        list.push(lines, "request past an expectation's limit: " + recorded_line(r))
    str.join(lines, "\n")

// One unsatisfied rule as one line: the index, the label, what was
// expected, what happened.
//
// ```novo
// use mockexpect
// use mockverify
//
// fn main() [io]
//     let u = HmUnsatisfied { rule: 1, label: "create a user",
//                             wanted: mockexpect.exactly(1), calls: 0 }
//     println(mockverify.unsatisfied_line(u))
// ```
pub fn unsatisfied_line(u: HmUnsatisfied) -> Str []
    "#${u.rule} ${u.label}: expected ${times_text(u.wanted)}, was called ${u.calls} time(s)"

// Verify, and report a failure through `std.test`.
//
// The wrapper a test's last line is, and the only `[io]` function in
// the module — the same split `snapshot-nv` draws between `check` and
// `assert_snapshot`, and for the same reason: a verdict can be asserted
// about, a failure cannot.
//
// ```novo
// use mockserver
// use mockverify
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => mockverify.assert_verified(m, [])
// ```
pub fn assert_verified(m: mockserver.HmMock, rules: [mockserver.HmRule]) [mutate, io]
    let v = verify(m, rules)
    if not v.satisfied
        // cov: skip — reports through std.test, which fails the test that reaches it
        test.fail(report(v))

// Assert that the mock saw exactly these requests, in this order.
//
// The other assertion a test makes, and deliberately separate from
// `verify`: "it was called" and "it was called with these, in this
// order" are different claims, and a library that only offered the
// second makes every test brittle.
//
// ```novo
// use mockmatch
// use mockserver
// use mockverify
//
// fn main() [io, fs, net, time, mutate, async]
//     match mockserver.start([])
//         Err(e) => println(e.message())
//         Ok(m)  => mockverify.assert_requests(m, [mockmatch.request("GET", "/ping")])
// ```
pub fn assert_requests(m: mockserver.HmMock, wanted: [mockmatch.HmRequest]) [mutate, io]
    match first_difference(recorded(m), wanted)
        None      => test.assert(true)
        // cov: skip — reports through std.test, which fails the test that reaches it
        Some(why) => test.fail(why)

// The recorded requests as one line each, for a failure message or a
// `--verbose` run.
//
// ```novo
// use mockverify
//
// fn main() [io]
//     println(mockverify.transcript([]))
// ```
pub fn transcript(seen: [HmRecorded]) -> Str []
    var lines: [Str] = []
    for r in seen
        list.push(lines, recorded_line(r))
    str.join(lines, "\n")

// A request no rule matched: nothing served it and the reply was not the
// `409` that marks an exhausted rule.
fn is_unexpected(r: HmRecorded) -> Bool
    r.served_by < 0 and r.status != 409

// What a call constraint says, in words.
fn times_text(t: mockexpect.HmTimes) -> Str
    if t.at_most < 0
        return "at least ${t.at_least} call(s)"
    if t.at_least == t.at_most
        return "exactly ${t.at_least} call(s)"
    if t.at_least == 0
        return "at most ${t.at_most} call(s)"
    "between ${t.at_least} and ${t.at_most} call(s)"

// One recorded request as a line: where it came in, what it was, what
// went back and which rule served it.
fn recorded_line(r: HmRecorded) -> Str
    let by = if r.served_by < 0
        "no rule"
    else
        "rule ${r.served_by}"
    "#${r.sequence} ${mockmatch.request_line(r.request)} -> ${r.status} (${by})"

// Whether a recorded request is the wanted one.
fn satisfies(seen: HmRequest, wanted: HmRequest) -> Bool
    if seen.method != wanted.method or seen.path != wanted.path
        return false
    for q in wanted.query
        if mockmatch.binding(seen.query, q.name) != Some(q.value)
            return false
    for h in wanted.headers
        if mockmatch.header(seen, h.name) != Some(h.value)
            return false
    wanted.body == "" or wanted.body == seen.body

// The first way a recording differs from the wanted requests, or `None`
// when it is these requests in this order.  A wanted request is satisfied
// by a recorded one that has its method and path and carries every query
// pair, header and non-empty body it names; extra headers and query
// pairs do not count against it, because a client adds ones a test did
// not write.
//
// ```novo
// use mockmatch
// use mockverify
//
// fn main() [io]
//     let why = mockverify.first_difference([], [mockmatch.request("GET", "/ping")])
//     println(why ?? "same")        // expected 1 request(s), the mock saw 0:
// ```
pub fn first_difference(seen: [HmRecorded], wanted: [mockmatch.HmRequest]) -> ?Str []
    if list.len(seen) != list.len(wanted)
        return Some("expected ${list.len(wanted)} request(s), the mock saw ${list.len(seen)}:\n" + transcript(seen))
    for i in 0..list.len(wanted)
        if not satisfies(seen[i].request, wanted[i])
            return Some("request #${i}: expected " + mockmatch.request_line(wanted[i])
                        + ", the mock saw " + mockmatch.request_line(seen[i].request))
    None
