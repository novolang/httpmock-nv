// mockreply.nv — what an expectation answers with.
//
// A reply is a value and not a handler.  The standard library's handler
// type is a plain function with a six-label effect row, so a reply that
// was a handler would cost that row, and could not be compared, printed
// or stored.  `HmReply` is a status, headers and a body.  `mockserver`
// converts one to the standard library's `HttpResponse` at the last
// moment, and that conversion is the only place in this package that
// names that type.
//
// A reply that depends on the request uses the `templated` field: `${id}`
// in a body or a header value is replaced by the path parameter `id`
// that the match bound.  There are no conditionals, no arithmetic and no
// way into code.  A mock whose replies are programs is a second
// implementation of the service under test.
//
// A delay is a field and not a call to sleep.  `delay_ms` makes "the
// client must time out" testable, and it is on the value so that a test
// of the decision can assert the delay without waiting for it.

use mockmatch

// One header on a reply.
//
// This package's own pair rather than the standard library's
// `HttpHeader`, so the whole of `mockreply` stays `[]` and comparable —
// see the module comment.
pub struct HmHeader
    name: Str
    value: Str

// What the mock sends back.
pub struct HmReply
    status: Int
    headers: [HmHeader]
    // The body as text.  `${name}` is substituted from the path
    // bindings when the reply is rendered; `render` is where that
    // happens and `body_literal` is how a body containing a literal
    // `${` is written.
    body: Str
    // Milliseconds to wait before answering.  `0` for none.  On the
    // value so a test can assert it without waiting.
    delay_ms: Int
    // Whether `${name}` in the body and the headers is substituted.
    // False for a body that is meant to contain one literally.
    templated: Bool

// A reply with a status and nothing else.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.status(204)
//     println("${r.status}")
// ```
pub fn status(code: Int) -> HmReply []
    HmReply { status: code, headers: [], body: "", delay_ms: 0, templated: true }

// A `200` with a text body and `text/plain; charset=utf-8`.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     println(mockreply.text(200, "pong").body)
// ```
pub fn text(code: Int, body: Str) -> HmReply []
    // workaround(a-parameter-named-like-a-function-of-its-module-makes-the-call-through-the-module-segfault): a call to the function `body` from a function that has a parameter `body` crashes when reached through the module, so both constructors call `typed`.
    typed(code, "text/plain; charset=utf-8", body)

// A reply with a JSON body and `application/json; charset=utf-8`.
//
// The body is sent exactly as written — this does not validate it,
// because a mock that refused malformed JSON could not be used to test
// what a client does with malformed JSON, which is the case people
// reach for a mock to test.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.json(200, "{\"ok\":true}")
//     println("${r.status}")
// ```
pub fn json(code: Int, body: Str) -> HmReply []
    // workaround(a-parameter-named-like-a-function-of-its-module-makes-the-call-through-the-module-segfault): see `text`.
    typed(code, "application/json; charset=utf-8", body)

// A reply with a body and a content type the caller names.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.body(200, "text/csv", "a,b\n")
//     println("${r.status}")
// ```
pub fn body(code: Int, content_type: Str, payload: Str) -> HmReply []
    typed(code, content_type, payload)

// A `3xx` with a `Location`.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.redirect(302, "/elsewhere")
//     println("${r.status}")
// ```
pub fn redirect(code: Int, location: Str) -> HmReply []
    with_header(status(code), "Location", location)

// The reply with one more header.
//
// ```novo
// use mockreply
// use std.list
//
// fn main() [io]
//     let r = mockreply.with_header(mockreply.status(200), "ETag", "abc")
//     println("${list.len(r.headers)}")
// ```
pub fn with_header(r: HmReply, name: Str, value: Str) -> HmReply []
    HmReply { status: r.status,
              headers: list.concat(r.headers, [HmHeader { name: name, value: value }]),
              body: r.body, delay_ms: r.delay_ms, templated: r.templated }

// The reply with a delay before it is sent.
//
// What makes "the client gives up after 500 ms" a test rather than a
// hope.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.with_delay(mockreply.status(200), 750)
//     println("${r.delay_ms}")
// ```
pub fn with_delay(r: HmReply, ms: Int) -> HmReply []
    HmReply { status: r.status, headers: r.headers, body: r.body, delay_ms: ms,
              templated: r.templated }

// The reply with template substitution turned off.
//
// For a body that contains a literal `${`, which a mock standing in for
// a template service will.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.body_literal(mockreply.text(200, "cost: \$42"))
//     println("${r.templated}")
// ```
pub fn body_literal(r: HmReply) -> HmReply []
    HmReply { status: r.status, headers: r.headers, body: r.body, delay_ms: r.delay_ms,
              templated: false }

// The reply, with `${name}` substituted from the path bindings.
//
// Applied to the body and to every header value.  An unbound name is
// left exactly as written rather than replaced with nothing: a response
// carrying `${id}` where `:id` was never in the pattern is a mistake in
// the test, and a silent empty string hides it.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.render(mockreply.text(200, "user \${id}"), [])
//     println(r.body)
// ```
pub fn render(r: HmReply, bindings: [mockmatch.HmBinding]) -> HmReply []
    if not r.templated
        return r
    var headers: [HmHeader] = []
    for h in r.headers
        list.push(headers, HmHeader { name: h.name, value: substituted(h.value, bindings) })
    HmReply { status: r.status, headers: headers, body: substituted(r.body, bindings),
              delay_ms: r.delay_ms, templated: false }

// Every `${name}` a reply names, in order.
//
// So a test can assert that a template's names are the ones the pattern
// binds — which is the one error `render` deliberately does not raise.
//
// ```novo
// use mockreply
// use std.list
//
// fn main() [io]
//     let names = mockreply.template_names(mockreply.text(200, "user \${id}"))
//     println("${list.len(names)}")
// ```
pub fn template_names(r: HmReply) -> [Str] []
    if not r.templated
        return []
    var out = names_in(r.body)
    for h in r.headers
        out = list.concat(out, names_in(h.value))
    out

// A header's value on a reply, compared case-insensitively.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     match mockreply.header(mockreply.json(200, "{}"), "content-type")
//         Some(v) => println(v)
//         None    => println("absent")
// ```
pub fn header(r: HmReply, name: Str) -> ?Str []
    let want = str.lower(name)
    for h in r.headers
        if str.lower(h.name) == want
            return Some(h.value)
    None

// The reply the mock sends when nothing matched: `404`, with
// `mockmatch.unmatched_report` as the body.
//
// A body and not an empty 404, because the first thing a person does
// with an unexpected 404 is print the response — and what they should
// find there is which expectation missed and why.
//
// ```novo
// use mockmatch
// use mockreply
//
// fn main() [io]
//     let r = mockreply.unmatched(mockmatch.request("GET", "/x"), [])
//     println("${r.status}")
// ```
pub fn unmatched(r: mockmatch.HmRequest, misses: [mockmatch.HmMiss]) -> HmReply []
    body_literal(text(404, mockmatch.unmatched_report(r, misses)))

// The reply the mock sends when an expectation is out of calls: `409`,
// naming the expectation and its ceiling.
//
// A different status from the unmatched one, on purpose: a client that
// retries on 404 and not on 409 then behaves differently in the two
// cases, and a test that is about the retry can tell them apart.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     let r = mockreply.exhausted("the token endpoint", 1)
//     println("${r.status}")
// ```
pub fn exhausted(label: Str, limit: Int) -> HmReply []
    body_literal(text(409, "expectation " + label + " has been served " + str.from_int(limit)
                           + " time(s), which is as many as it allows"))

// The reply as one line for a log: the status and the body's length.
//
// ```novo
// use mockreply
//
// fn main() [io]
//     println(mockreply.reply_line(mockreply.text(200, "pong")))
// ```
pub fn reply_line(r: HmReply) -> Str []
    "${r.status} (${str.len(r.body)} bytes)"

// The position of the next complete `${name}` at or after `from`, as the
// offsets of `$` and of `}`, or `None`.
fn next_hole(s: Str, from: Int) -> ?(Int, Int)
    match str.index_from(s, "\${", from)
        None    => None
        Some(a) =>
            match str.index_from(s, "}", a + 2)
                None    => None
                Some(b) => Some((a, b))

// `s` with each `${name}` that has a binding replaced by its value.  A
// name with no binding is left as written, and so is a `${` with no
// closing brace.  A value is inserted as it is and is not scanned again.
fn substituted(s: Str, bindings: [mockmatch.HmBinding]) -> Str
    var out = ""
    var at = 0
    var more = true
    while more
        match next_hole(s, at)
            None       =>
                out = out + str.slice(s, at, str.len(s))
                more = false
            Some(hole) =>
                let name = str.slice(s, hole.0 + 2, hole.1)
                out = out + str.slice(s, at, hole.0)
                match mockmatch.binding(bindings, name)
                    Some(v) =>
                        out = out + v
                    None    =>
                        out = out + str.slice(s, hole.0, hole.1 + 1)
                at = hole.1 + 1
    out

fn names_in(s: Str) -> [Str]
    var out: [Str] = []
    var at = 0
    var more = true
    while more
        match next_hole(s, at)
            None       =>
                more = false
            Some(hole) =>
                list.push(out, str.slice(s, hole.0 + 2, hole.1))
                at = hole.1 + 1
    out

fn typed(code: Int, content_type: Str, payload: Str) -> HmReply
    HmReply { status: code, headers: [HmHeader { name: "Content-Type", value: content_type }],
              body: payload, delay_ms: 0, templated: true }
